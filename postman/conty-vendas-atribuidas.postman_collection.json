							"mode": "raw",
							"raw": "{\n  \"id\": \"rf-{{orderId}}-1\",\n  \"order_id\": \"{{orderId}}\",\n  \"amount\": \"30.00\",\n  \"currency\": \"BRL\",\n  \"created_at\": \"2026-10-10T11:59:00Z\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
