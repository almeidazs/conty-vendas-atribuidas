{
	"info": {
		"name": "Conty - vendas atribuídas",
		"description": "Fluxo completo de pedido e estornos, erros e health. Os webhooks são assinados pelo script da coleção (HMAC-SHA256 do corpo, em Base64, no header X-Webhook-Signature). Rode a coleção inteira, na ordem.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"if (!pm.collectionVariables.get('runId')) {",
					"\tconst runId = pm.variables.replaceIn('{{$timestamp}}');",
					"\tpm.collectionVariables.set('runId', runId);",
					"\tpm.collectionVariables.set('orderId', `pm-${runId}`);",
					"\tpm.collectionVariables.set('couponLower', `pm${runId}`);",
					"}",
					"if (pm.request.url.getPath().startsWith('/webhooks/')) {",
					"\tconst CryptoJS = require('crypto-js');",
					"\t// A assinatura vale para os bytes enviados: resolve as variáveis antes de assinar.",
					"\tconst body = pm.variables.replaceIn(pm.request.body.raw);",
					"\tpm.request.body.update(body);",
					"\tconst secret = pm.variables.get('webhookSecret');",
					"\tconst signature = CryptoJS.enc.Base64.stringify(CryptoJS.HmacSHA256(body, secret));",
					"\tpm.request.headers.upsert({ key: 'X-Webhook-Signature', value: signature });",
					"}"
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8787"
		},
		{
			"key": "webhookSecret",
			"value": "dev-webhook-secret"
		},
		{
			"key": "runId",
			"value": ""
		},
		{
			"key": "orderId",
			"value": ""
		},
		{
			"key": "couponLower",
			"value": ""
		},
		{
			"key": "creatorId",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Fluxo",
			"item": [
				{
					"name": "Criar criador",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/creators",
							"host": ["{{baseUrl}}"],
							"path": ["creators"]
						},
						"description": "Gera um runId novo a cada execução (orderId, utm e cupom únicos) e cadastra um criador para a rodada.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Criador Postman\",\n  \"utm_code\": \"pm-{{runId}}\",\n  \"coupons\": [\n    \"pm{{runId}}\"\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const runId = pm.variables.replaceIn('{{$timestamp}}') + Math.floor(Math.random() * 1000);",
									"pm.collectionVariables.set('runId', runId);",
									"pm.collectionVariables.set('orderId', `pm-${runId}`);",
									"pm.collectionVariables.set('couponLower', `pm${runId}`);"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('201 Created', () => pm.response.to.have.status(201));",
									"const body = pm.response.json();",
									"pm.test('código normalizado e sem vendas', () => {",
									"\tpm.expect(body.utmCode).to.eql(`pm-${pm.collectionVariables.get('runId')}`);",
									"\tpm.expect(body.coupons).to.eql([`PM${pm.collectionVariables.get('runId')}`]);",
									"\tpm.expect(body.totals).to.eql([]);",
									"});",
									"pm.collectionVariables.set('creatorId', body.id);"
								]
							}
						}
					]
				},
				{
					"name": "Estorno antes do pedido (202 pendente)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
